# Only shared runtime dependencies; the installed native toolchain is mounted
# read-only. No opam state, source repository, credentials, or Docker socket.
ARG BASE_IMAGE=ubuntu:26.04@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 libgmp10 libseccomp2 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir /work /tool /inputs /bundle /artifacts
ENV PATH=/opt/rocq/master/bin:/usr/bin:/bin HOME=/tmp TMPDIR=/tmp \
    LANG=C.UTF-8 OCAMLRUNPARAM=b=0,d=1 \
    OCAMLPATH=/opt/rocq/master/lib \
    OCAMLFIND_CONF=/opt/rocq/master/lib/findlib.conf
USER 65532:65532
WORKDIR /work
