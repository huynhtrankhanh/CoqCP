# Docker exports a standalone host; proof execution does not require Docker.
FROM ubuntu:24.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 python3-venv binutils && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /venv
COPY host-requirements.txt /build/host-requirements.txt
RUN /venv/bin/pip install --no-cache-dir -r /build/host-requirements.txt
COPY wasi_host.py wasi_fs.py /build/
RUN /venv/bin/pyinstaller --noconfirm --clean --onedir --name coqcp-wasi-host \
    --collect-all wasmtime \
    --add-binary '/venv/lib/python3.12/site-packages/wasmtime/linux-x86_64/_libwasmtime.so:wasmtime/linux-x86_64' \
    --distpath /out --workpath /tmp/build --specpath /tmp \
    /build/wasi_host.py
FROM scratch AS export
COPY --from=build /out/coqcp-wasi-host/ /host/
