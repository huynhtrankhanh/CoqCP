environment({
  meta: array([int64], 16),
  formulas: array([int64, int64, int64], 0),
  classes: array([int64, int64], 0),
  theorems: array([int64], 0),
  frames: array([int64, int64, int64, int64], 0),
  bindings: array([int64, int64, int64, int64], 0),
  names: array([int8], 0),
  token: array([int8], 1024),
  printBuffer: array([int8], 20),
})

procedure('intern', {tag: int64, a: int64, b: int64, found: int64}, () => {
  set('found', 0)
  range(retrieve('meta', 1)[0], (i) => {
    if (retrieve('formulas', i)[0] == get('tag') && retrieve('formulas', i)[1] == get('a') && retrieve('formulas', i)[2] == get('b')) {
      store('meta', 0, [i])
      set('found', 1)
      ;('break')
    }
  })
  if (get('found') == 0 && retrieve('meta', 8)[0] == 0) {
    if (retrieve('meta', 1)[0] == 18446744073709551615) {
      store('meta', 8, [1])
    } else {
      store('meta', 0, [retrieve('meta', 1)[0]])
      grow('formulas', retrieve('meta', 1)[0] + 1)
      store('formulas', retrieve('meta', 1)[0], [get('tag'), get('a'), get('b')])
      store('meta', 1, [retrieve('meta', 1)[0] + 1])
    }
  }
})

procedure('push', {node: int64, depth: int64}, () => {
  if (retrieve('meta', 10)[0] == 18446744073709551615) {
    store('meta', 8, [1])
  } else {
    grow('frames', retrieve('meta', 10)[0] + 1)
    store('frames', retrieve('meta', 10)[0], [get('node'), get('depth'), 0, 0])
    store('meta', 10, [retrieve('meta', 10)[0] + 1])
  }
})

procedure('readToken', {done: int64}, () => {
  store('meta', 6, [0])
  store('meta', 14, [0])
  set('done', 0)
  tapeEnd((ch) => {
    if (ch == 32 || ch == 9 || ch == 10 || ch == 13) {
      if (retrieve('meta', 6)[0] != 0) {
        set('done', 1)
        ;('break')
      }
    } else {
      if (retrieve('meta', 6)[0] == 1024) {
        store('meta', 8, [1])
        ;('break')
      }
      store('token', retrieve('meta', 6)[0], [coerceInt8(ch)])
      store('meta', 6, [retrieve('meta', 6)[0] + 1])
    }
  })
  if (get('done') == 0 && retrieve('meta', 8)[0] == 0) { store('meta', 7, [1]) }
  if (retrieve('meta', 6)[0] != 0 && retrieve('meta', 8)[0] == 0) { store('meta', 14, [1]) }
})

procedure('readNat', {digit: int64, value: int64}, () => {
  call('readToken', {})
  set('value', 0)
  if (retrieve('meta', 14)[0] != 0) {
    range(retrieve('meta', 6)[0], (i) => {
      set('digit', coerceInt64(retrieve('token', i)[0]))
      if (less(get('digit'), 48) || less(57, get('digit'))) {
        store('meta', 14, [0])
        ;('break')
      }
      set('digit', get('digit') - 48)
      if (less(divide(18446744073709551615 - get('digit'), 10), get('value'))) {
        store('meta', 14, [0])
        ;('break')
      }
      set('value', get('value') * 10 + get('digit'))
    })
  }
  store('meta', 11, [get('value')])
})

procedure('lookup', {equal: int64}, () => {
  store('meta', 0, [18446744073709551615])
  range(retrieve('meta', 4)[0], (i) => {
    if (retrieve('bindings', i)[1] == retrieve('meta', 6)[0]) {
      set('equal', 1)
      range(retrieve('meta', 6)[0], (j) => {
        if (retrieve('names', retrieve('bindings', i)[0] + j)[0] != retrieve('token', j)[0]) {
          set('equal', 0)
          ;('break')
        }
      })
      if (get('equal') != 0) {
        store('meta', 0, [i])
        ;('break')
      }
    }
  })
})

procedure('ok', {value: int64}, () => {
  range('OK ', (c) => { writeChar(c) })
  call(PrintInt64, {buffer: 'printBuffer'}, 'unsigned', {num: get('value')})
  writeChar(coerceInt8(10))
  ;('flush')
})
procedure('no', {}, () => {
  range('NO\n', (c) => { writeChar(c) })
  ;('flush')
})
procedure('appendTheorem', {node: int64}, () => {
  if (retrieve('meta', 8)[0] == 0) {
    if (retrieve('meta', 3)[0] == 18446744073709551615) {
      store('meta', 8, [1])
    } else {
      grow('theorems', retrieve('meta', 3)[0] + 1)
      store('theorems', retrieve('meta', 3)[0], [get('node')])
      call('ok', {value: retrieve('meta', 3)[0]})
      store('meta', 3, [retrieve('meta', 3)[0] + 1])
    }
  }
})

procedure('modusPonens', {implication: int64, antecedent: int64, node: int64}, () => {
  set('node', retrieve('theorems', get('implication'))[0])
  if (retrieve('formulas', get('node'))[0] == 3 && retrieve('formulas', get('node'))[1] == retrieve('theorems', get('antecedent'))[0]) {
    call('appendTheorem', {node: retrieve('formulas', get('node'))[2]})
  } else { call('no', {}) }
})

procedure('generalize', {theorem: int64}, () => {
  call('intern', {tag: 4, a: retrieve('theorems', get('theorem'))[0], b: 0})
  call('appendTheorem', {node: retrieve('meta', 0)[0]})
})
