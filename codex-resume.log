  - intro Hrun. injection Hrun as _ <-. reflexivity.
  - intro Hrun. injection Hrun as _ <-. reflexivity.
  - intro Hrun. injection Hrun as _ <-. reflexivity.
Qed.

Context {V : Type} `{EqDecision V}.
Lemma localStep_input_length (effect : WithLocalVariables I T V) (f : @Frame I T V) value final :
  localStep effect f = Some (value,final) ->
