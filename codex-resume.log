    | @store => lazymatch code with store _ _ _ arraydef_0__meta ?slot ?value =>
        let Hstep := fresh \"Hstep\" in
        assert (Hstep : expression = Some (tt,(setMachine frame (store_meta (machine frame) (Z.to_nat slot) value),trace))) by
