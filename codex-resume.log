  - intro Hrun. injection Hrun as _ <-. reflexivity.
  - intro Hrun. injection Hrun as _ <-. reflexivity.
  - intro Hrun. injection Hrun as _ <-. reflexivity.
Qed.

Theorem execLocal_input_length {R}
  (code : Action (WithLocalVariables I T V) withLocalVariablesReturnValue R) f value final :
  execLocal code f = Some (value,final) ->
