  let code := eval cbv beta iota zeta in code in
  let raw := eval unfold CommandChain.source_chain in (CommandChain.source_chain reader) in
  let abstracted := eval pattern raw in code in
  lazymatch abstracted with ?family _ => exact (family sequence) end).
