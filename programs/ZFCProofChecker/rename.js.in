// Iterative traversal; no native recursion and no extracted Gallina kernel.
procedure('renameIndex', {index: int64, depth: int64, mode: int64, shift: int64, arg: int64, root: int64, mapped: int64}, () => {
  store('meta', 0, [get('index')])
  if (!less(get('index'), get('depth'))) {
    set('root', get('index') - get('depth'))
    set('mapped', get('root'))
    if (get('mode') == 0) {
      if (less(18446744073709551615 - get('root'), get('shift'))) { store('meta', 8, [1]) }
      set('mapped', get('root') + get('shift'))
    }
    if (get('mode') == 1) {
      if (get('root') == 0) { set('mapped', get('arg')) } else { set('mapped', get('root') - 1) }
    }
    if (get('mode') == 2 && get('root') != 0) {
      if (get('root') == 18446744073709551615) { store('meta', 8, [1]) }
      set('mapped', get('root') + 1)
    }
    if (get('mode') == 3 || get('mode') == 4 || get('mode') == 5) {
      if (get('root') == 0 && get('mode') != 5) { set('mapped', 2) }
      if (get('root') == 1 && get('mode') == 4) { set('mapped', 0) }
      if (!less(get('root'), 2)) {
        if (get('root') == 18446744073709551615) { store('meta', 8, [1]) }
        set('mapped', get('root') + 1)
      }
    }
    if (get('mode') == 6) {
      if (get('root') == 0) { set('mapped', get('arg')) } else {
        if (less(18446744073709551615 - (get('root') - 1), get('shift'))) { store('meta', 8, [1]) }
        set('mapped', get('root') - 1 + get('shift'))
      }
    }
    if (less(18446744073709551615 - get('mapped'), get('depth'))) { store('meta', 8, [1]) }
    store('meta', 0, [get('mapped') + get('depth')])
  }
})

// Sparse per-substitution memo table. Tag 5 separates memo keys from formula
// tuples. Both use SipHash-2-4 under the seed supplied in the initial handshake.
// Occupancy is explicit: source ID/depth/result zero are ordinary valid values.
procedure('renameCacheGet', { node: int64, depth: int64, slot: int64, size: int64 }, () => {
  store('meta', 31, [18446744073709551615])
  set('size', retrieve('meta', 29)[0])
  call('formulaHash', { tag: 5, a: get('node'), b: get('depth') })
  set('slot', retrieve('meta', 28)[0] % get('size'))
  range(get('size'), (probe) => {
    if (retrieve('renameMemo', get('slot'))[3] == 0) { ;('break') }
    if (retrieve('renameMemo', get('slot'))[0] == get('node') &&
        retrieve('renameMemo', get('slot'))[1] == get('depth')) {
      store('meta', 31, [retrieve('renameMemo', get('slot'))[2]])
      ;('break')
    }
    set('slot', (get('slot') + 1) % get('size'))
  })
})
procedure('renameCacheGrow', { oldSize: int64, size: int64, slot: int64, placed: int64 }, () => {
  set('oldSize', retrieve('meta', 29)[0])
  if (less(9223372036854775807, get('oldSize'))) {
    store('meta', 8, [1])
  } else {
    set('size', get('oldSize') * 2)
    grow('renameMemoScratch', get('size'))
    range(get('size'), (i) => { store('renameMemoScratch', i, [0, 0, 0, 0]) })
    range(get('oldSize'), (i) => {
      if (retrieve('renameMemo', i)[3] != 0) {
        call('formulaHash', { tag: 5, a: retrieve('renameMemo', i)[0], b: retrieve('renameMemo', i)[1] })
        set('slot', retrieve('meta', 28)[0] % get('size'))
        set('placed', 0)
        range(get('size'), (probe) => {
          if (retrieve('renameMemoScratch', get('slot'))[3] == 0) {
            store('renameMemoScratch', get('slot'), [retrieve('renameMemo', i)[0], retrieve('renameMemo', i)[1], retrieve('renameMemo', i)[2], 1])
            set('placed', 1)
            ;('break')
          }
          set('slot', (get('slot') + 1) % get('size'))
        })
        if (get('placed') == 0) { store('meta', 8, [1]) }
      }
    })
    if (retrieve('meta', 8)[0] == 0) {
      grow('renameMemo', get('size'))
      range(get('size'), (i) => {
        store('renameMemo', i, [retrieve('renameMemoScratch', i)[0], retrieve('renameMemoScratch', i)[1], retrieve('renameMemoScratch', i)[2], retrieve('renameMemoScratch', i)[3]])
      })
      store('meta', 29, [get('size')])
    }
  }
})
procedure('renameCachePut', { node: int64, depth: int64, value: int64, size: int64, slot: int64, placed: int64 }, () => {
  if (!less(retrieve('meta', 30)[0], divide(retrieve('meta', 29)[0], 2))) {
    call('renameCacheGrow', {})
  }
  if (retrieve('meta', 8)[0] == 0) {
    set('size', retrieve('meta', 29)[0])
    call('formulaHash', { tag: 5, a: get('node'), b: get('depth') })
    set('slot', retrieve('meta', 28)[0] % get('size'))
    set('placed', 0)
    range(get('size'), (probe) => {
      if (retrieve('renameMemo', get('slot'))[3] == 0) {
        store('renameMemo', get('slot'), [get('node'), get('depth'), get('value'), 1])
        store('meta', 30, [retrieve('meta', 30)[0] + 1])
        set('placed', 1)
        ;('break')
      }
      if (retrieve('renameMemo', get('slot'))[0] == get('node') &&
          retrieve('renameMemo', get('slot'))[1] == get('depth')) {
        store('renameMemo', get('slot'), [get('node'), get('depth'), get('value'), 1])
        set('placed', 1)
        ;('break')
      }
      set('slot', (get('slot') + 1) % get('size'))
    })
    if (get('placed') == 0) { store('meta', 8, [1]) }
  }
})

procedure(
  'rename',
  {
    node: int64,
    width: int64,
    pairs: int64,
    budget: int64,
    mode: int64,
    shift: int64,
    arg: int64,
    initialDepth: int64,
    top: int64,
    current: int64,
    depth: int64,
    phase: int64,
    tag: int64,
    a: int64,
    b: int64,
    left: int64,
    result: int64,
  },
  () => {
    // For n = root ID + 1 there are at most n^2 source/depth pairs.
    // Each pair is expanded once; cached child visits add at most two per pair.
    // Overflow is fatal, rather than wrapping the finite traversal budget.
    store('meta', 10, [0])
    store('meta', 29, [16])
    store('meta', 30, [0])
    grow('renameMemo', 16)
    range(16, (i) => { store('renameMemo', i, [0, 0, 0, 0]) })
    if (get('node') == 18446744073709551615) {
      store('meta', 8, [1])
    } else {
      set('width', get('node') + 1)
      if (less(divide(18446744073709551615, get('width')), get('width'))) {
        store('meta', 8, [1])
      } else {
        set('pairs', get('width') * get('width'))
        if (less(divide(18446744073709551614, 5), get('pairs'))) {
          store('meta', 8, [1])
        } else {
          set('budget', get('pairs') * 5 + 1)
          call('push', { node: get('node'), depth: get('initialDepth') })
          range(get('budget'), (work) => {
            if (retrieve('meta', 10)[0] == 0 || retrieve('meta', 8)[0] != 0) {
              ;('break')
            }
RENAME_STEP
          })
        }
      }
    }
    if (retrieve('meta', 10)[0] != 0) {
      store('meta', 8, [1])
    }
  }
)
