// Unconnected/incomplete work toward conclusion evaluation. Required arrays:
// uniformMemoState: array([int64, int64, int64, int64], 1),
// uniformMemoBuckets: array([int64], 1024),
// uniformMemoEntries: array([int64, int64, int64, int64], 0).
// State fields are count, bucket count, found, result. Entries are node,
// depth, result, next link (index + 1; zero marks the end). This table is
// independent of renameMemo because expansion calls rename recursively.
// The experimental evaluator has no correctness proof or production integration.
// formulaHash requires the main formula table size meta[20] to be nonzero.

procedure('uniformMemoReset', {}, () => {
  range(1024, (i) => { store('uniformMemoBuckets', i, [0]) })
  store('uniformMemoState', 0, [0, 1024, 0, 0])
})

procedure('uniformMemoGet', {node: int64, depth: int64, size: int64, bucket: int64, current: int64}, () => {
  set('size', retrieve('uniformMemoState', 0)[1])
  store('uniformMemoState', 0, [retrieve('uniformMemoState', 0)[0], get('size'), 0, 0])
  if (get('size') == 0) { store('meta', 8, [1]) } else {
    call('formulaHash', {tag: 51, a: get('node'), b: get('depth')})
    set('bucket', retrieve('meta', 28)[0] % get('size'))
    set('current', retrieve('uniformMemoBuckets', get('bucket'))[0])
    range(retrieve('uniformMemoState', 0)[0], (probe) => {
      if (get('current') == 0) { ;('break') }
      set('current', get('current') - 1)
      if (retrieve('uniformMemoEntries', get('current'))[0] == get('node') && retrieve('uniformMemoEntries', get('current'))[1] == get('depth')) {
        store('uniformMemoState', 0, [retrieve('uniformMemoState', 0)[0], get('size'), 1, retrieve('uniformMemoEntries', get('current'))[2]])
        ;('break')
      }
      set('current', retrieve('uniformMemoEntries', get('current'))[3])
    })
  }
})

procedure('uniformMemoGrow', {size: int64, bucket: int64}, () => {
  set('size', retrieve('uniformMemoState', 0)[1])
  if (less(9223372036854775807, get('size'))) { store('meta', 8, [1]) } else {
    set('size', get('size') * 2)
    grow('uniformMemoBuckets', get('size'))
    range(get('size'), (i) => { store('uniformMemoBuckets', i, [0]) })
    store('uniformMemoState', 0, [retrieve('uniformMemoState', 0)[0], get('size'), 0, 0])
    range(retrieve('uniformMemoState', 0)[0], (i) => {
      call('formulaHash', {tag: 51, a: retrieve('uniformMemoEntries', i)[0], b: retrieve('uniformMemoEntries', i)[1]})
      set('bucket', retrieve('meta', 28)[0] % get('size'))
      store('uniformMemoEntries', i, [retrieve('uniformMemoEntries', i)[0], retrieve('uniformMemoEntries', i)[1], retrieve('uniformMemoEntries', i)[2], retrieve('uniformMemoBuckets', get('bucket'))[0]])
      store('uniformMemoBuckets', get('bucket'), [i + 1])
    })
  }
})

// Requires the caller to have established that the pair is not already in the
// table. Keeping this invariant avoids contradictory cached values.
procedure('uniformMemoPutNew', {node: int64, depth: int64, value: int64, count: int64, bucket: int64}, () => {
  if (retrieve('uniformMemoState', 0)[1] == 0) { store('meta', 8, [1]) } else {
    if (retrieve('uniformMemoState', 0)[0] == retrieve('uniformMemoState', 0)[1]) { call('uniformMemoGrow', {}) }
  }
  if (retrieve('meta', 8)[0] == 0) {
    set('count', retrieve('uniformMemoState', 0)[0])
    if (get('count') == 18446744073709551615) { store('meta', 8, [1]) } else {
      call('formulaHash', {tag: 51, a: get('node'), b: get('depth')})
      set('bucket', retrieve('meta', 28)[0] % retrieve('uniformMemoState', 0)[1])
      grow('uniformMemoEntries', get('count') + 1)
      store('uniformMemoEntries', get('count'), [get('node'), get('depth'), get('value'), retrieve('uniformMemoBuckets', get('bucket'))[0]])
      store('uniformMemoBuckets', get('bucket'), [get('count') + 1])
      store('uniformMemoState', 0, [get('count') + 1, retrieve('uniformMemoState', 0)[1], 0, 0])
    }
  }
})
