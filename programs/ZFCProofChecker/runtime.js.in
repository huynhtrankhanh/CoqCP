environment({
  meta: array([int64], 32),
  sipState: array([int64, int64, int64, int64], 1),
  formulaBuckets: array([int64], 1024),
  formulaLinks: array([int64], 0),
  formulas: array([int64, int64, int64], 0),
  classes: array([int64, int64], 0),
  theorems: array([int64], 0),
  frames: array([int64, int64, int64, int64], 0),
  bindings: array([int64, int64, int64, int64, int64], 0),
  schemaNodes: array([int64, int64, int64, int64, int64, int64, int64], 0),
  schemaValues: array([int64], 0),
  schemaMarks: array([int8], 0),
  schemaArguments: array([int64], 0),
  names: array([int8], 0),
  token: array([int8], 1024),
  printBuffer: array([int8], 20),
})

procedure('sipRound', {v0: int64, v1: int64, v2: int64, v3: int64}, () => {
  set('v0', retrieve('sipState', 0)[0])
  set('v1', retrieve('sipState', 0)[1])
  set('v2', retrieve('sipState', 0)[2])
  set('v3', retrieve('sipState', 0)[3])
  set('v0', get('v0') + get('v1'))
  set('v1', ((get('v1') << 13) | (get('v1') >> 51)) ^ get('v0'))
  set('v0', (get('v0') << 32) | (get('v0') >> 32))
  set('v2', get('v2') + get('v3'))
  set('v3', ((get('v3') << 16) | (get('v3') >> 48)) ^ get('v2'))
  set('v0', get('v0') + get('v3'))
  set('v3', ((get('v3') << 21) | (get('v3') >> 43)) ^ get('v0'))
  set('v2', get('v2') + get('v1'))
  set('v1', ((get('v1') << 17) | (get('v1') >> 47)) ^ get('v2'))
  set('v2', (get('v2') << 32) | (get('v2') >> 32))
  store('sipState', 0, [get('v0'), get('v1'), get('v2'), get('v3')])
})
procedure('sipWord', {word: int64}, () => {
  store('sipState', 0, [retrieve('sipState', 0)[0], retrieve('sipState', 0)[1], retrieve('sipState', 0)[2], retrieve('sipState', 0)[3] ^ get('word')])
  call('sipRound', {})
  call('sipRound', {})
  store('sipState', 0, [retrieve('sipState', 0)[0] ^ get('word'), retrieve('sipState', 0)[1], retrieve('sipState', 0)[2], retrieve('sipState', 0)[3]])
})
// SipHash-2-4 of three little-endian 64-bit words (24 bytes), keyed by the seed.
procedure('formulaHash', {tag: int64, a: int64, b: int64, hash: int64}, () => {
  store('sipState', 0, [8317987319222330741 ^ retrieve('meta', 26)[0], 7237128888997146477 ^ retrieve('meta', 27)[0], 7816392313619706465 ^ retrieve('meta', 26)[0], 8387220255154660723 ^ retrieve('meta', 27)[0]])
  call('sipWord', {word: get('tag')})
  call('sipWord', {word: get('a')})
  call('sipWord', {word: get('b')})
  call('sipWord', {word: 1729382256910270464})
  store('sipState', 0, [retrieve('sipState', 0)[0], retrieve('sipState', 0)[1], retrieve('sipState', 0)[2] ^ 255, retrieve('sipState', 0)[3]])
  range(4, (i) => { call('sipRound', {}) })
  set('hash', retrieve('sipState', 0)[0] ^ retrieve('sipState', 0)[1] ^ retrieve('sipState', 0)[2] ^ retrieve('sipState', 0)[3])
  store('meta', 28, [get('hash')])
  store('meta', 21, [get('hash') % retrieve('meta', 20)[0]])
})

procedure('rehashFormulas', {size: int64, bucket: int64}, () => {
  set('size', retrieve('meta', 20)[0])
  if (less(9223372036854775807, get('size'))) { store('meta', 8, [1]) } else {
    set('size', get('size') * 2)
    grow('formulaBuckets', get('size'))
    range(get('size'), (i) => { store('formulaBuckets', i, [0]) })
    store('meta', 20, [get('size')])
    range(retrieve('meta', 1)[0], (i) => {
      call('formulaHash', {tag: retrieve('formulas', i)[0], a: retrieve('formulas', i)[1], b: retrieve('formulas', i)[2]})
      set('bucket', retrieve('meta', 21)[0])
      store('formulaLinks', i, [retrieve('formulaBuckets', get('bucket'))[0]])
      store('formulaBuckets', get('bucket'), [i + 1])
    })
  }
})

procedure('intern', {tag: int64, a: int64, b: int64, found: int64, current: int64, bucket: int64}, () => {
  set('found', 0)
  if (retrieve('meta', 1)[0] == retrieve('meta', 20)[0]) { call('rehashFormulas', {}) }
  if (retrieve('meta', 8)[0] == 0) {
    call('formulaHash', {tag: get('tag'), a: get('a'), b: get('b')})
    set('bucket', retrieve('meta', 21)[0])
    set('current', retrieve('formulaBuckets', get('bucket'))[0])
    range(retrieve('meta', 1)[0], (probe) => {
      if (get('current') == 0) { ;('break') }
      set('current', get('current') - 1)
      if (retrieve('formulas', get('current'))[0] == get('tag') && retrieve('formulas', get('current'))[1] == get('a') && retrieve('formulas', get('current'))[2] == get('b')) {
        store('meta', 0, [get('current')])
        set('found', 1)
        ;('break')
      }
      set('current', retrieve('formulaLinks', get('current'))[0])
    })
    if (get('found') == 0) {
      if (retrieve('meta', 1)[0] == 18446744073709551615) { store('meta', 8, [1]) } else {
        store('meta', 0, [retrieve('meta', 1)[0]])
        grow('formulas', retrieve('meta', 1)[0] + 1)
        grow('formulaLinks', retrieve('meta', 1)[0] + 1)
        store('formulas', retrieve('meta', 1)[0], [get('tag'), get('a'), get('b')])
        store('formulaLinks', retrieve('meta', 1)[0], [retrieve('formulaBuckets', get('bucket'))[0]])
        store('formulaBuckets', get('bucket'), [retrieve('meta', 1)[0] + 1])
        store('meta', 1, [retrieve('meta', 1)[0] + 1])
      }
    }
  }
})

procedure('push', {node: int64, depth: int64}, () => {
  if (retrieve('meta', 10)[0] == 18446744073709551615) {
    store('meta', 8, [1])
  } else {
    grow('frames', retrieve('meta', 10)[0] + 1)
    store('frames', retrieve('meta', 10)[0], [get('node'), get('depth'), 0, 0])
    store('meta', 10, [retrieve('meta', 10)[0] + 1])
  }
})

procedure('tokenByte', {ch: int64}, () => {
  if (get('ch') == 32 || get('ch') == 9 || get('ch') == 10 || get('ch') == 13) {
    if (retrieve('meta', 6)[0] != 0) { store('meta', 17, [1]) }
  } else {
    if (retrieve('meta', 6)[0] == 1024) { store('meta', 8, [1]) } else {
      store('token', retrieve('meta', 6)[0], [coerceInt8(get('ch'))])
      store('meta', 6, [retrieve('meta', 6)[0] + 1])
    }
  }
})

procedure('readToken', {}, () => {
  store('meta', 6, [0])
  store('meta', 14, [0])
  store('meta', 17, [0])
  if (retrieve('meta', 15)[0] != 0) {
    call('tokenByte', {ch: retrieve('meta', 15)[0] - 1})
    store('meta', 15, [0])
  }
  if (retrieve('meta', 17)[0] == 0 && retrieve('meta', 8)[0] == 0) {
    tapeEnd((ch) => {
      call('tokenByte', {ch: coerceInt64(ch)})
      if (retrieve('meta', 17)[0] != 0 || retrieve('meta', 8)[0] != 0) { ;('break') }
    })
    if (retrieve('meta', 17)[0] == 0 && retrieve('meta', 8)[0] == 0) { store('meta', 7, [1]) }
  }
  if (retrieve('meta', 6)[0] != 0 && retrieve('meta', 8)[0] == 0) { store('meta', 14, [1]) }
})

procedure('readNat', {digit: int64, value: int64}, () => {
  call('readToken', {})
  set('value', 0)
  if (retrieve('meta', 14)[0] != 0) {
    range(retrieve('meta', 6)[0], (i) => {
      set('digit', coerceInt64(retrieve('token', i)[0]))
      if (less(get('digit'), 48) || less(57, get('digit'))) {
        store('meta', 14, [0])
        ;('break')
      }
      set('digit', get('digit') - 48)
      if (less(divide(18446744073709551615 - get('digit'), 10), get('value'))) {
        store('meta', 14, [0])
        ;('break')
      }
      set('value', get('value') * 10 + get('digit'))
    })
  }
  store('meta', 11, [get('value')])
})

procedure('lookup', {equal: int64}, () => {
  store('meta', 0, [18446744073709551615])
  range(retrieve('meta', 4)[0], (i) => {
    if (retrieve('bindings', i)[1] == retrieve('meta', 6)[0]) {
      set('equal', 1)
      range(retrieve('meta', 6)[0], (j) => {
        if (retrieve('names', retrieve('bindings', i)[0] + j)[0] != retrieve('token', j)[0]) {
          set('equal', 0)
          ;('break')
        }
      })
      if (get('equal') != 0) {
        store('meta', 0, [i])
        ;('break')
      }
    }
  })
})

procedure('ok', {value: int64}, () => {
  range('OK ', (c) => { writeChar(c) })
  call(PrintInt64, {buffer: 'printBuffer'}, 'unsigned', {num: get('value')})
  writeChar(coerceInt8(10))
  ;('flush')
})
procedure('no', {}, () => {
  range('NO\n', (c) => { writeChar(c) })
  ;('flush')
})
procedure('bindName', {value: int64, kind: int64}, () => {
  call('lookup', {})
  if (retrieve('meta', 0)[0] != 18446744073709551615) { call('no', {}) } else {
    if (retrieve('meta', 4)[0] == 18446744073709551615 || less(18446744073709551615 - retrieve('meta', 5)[0], retrieve('meta', 6)[0])) {
      store('meta', 8, [1])
    } else {
      grow('names', retrieve('meta', 5)[0] + retrieve('meta', 6)[0])
      range(retrieve('meta', 6)[0], (i) => {
        store('names', retrieve('meta', 5)[0] + i, [retrieve('token', i)[0]])
      })
      grow('bindings', retrieve('meta', 4)[0] + 1)
      store('bindings', retrieve('meta', 4)[0], [retrieve('meta', 5)[0], retrieve('meta', 6)[0], get('value'), 0, get('kind')])
      store('meta', 5, [retrieve('meta', 5)[0] + retrieve('meta', 6)[0]])
      call('ok', {value: get('value')})
      store('meta', 4, [retrieve('meta', 4)[0] + 1])
    }
  }
})
procedure('appendTheorem', {node: int64}, () => {
  if (retrieve('meta', 8)[0] == 0) {
    if (retrieve('meta', 3)[0] == 18446744073709551615) {
      store('meta', 8, [1])
    } else {
      grow('theorems', retrieve('meta', 3)[0] + 1)
      store('theorems', retrieve('meta', 3)[0], [get('node')])
      call('ok', {value: retrieve('meta', 3)[0]})
      store('meta', 3, [retrieve('meta', 3)[0] + 1])
    }
  }
})

procedure('modusPonens', {implication: int64, antecedent: int64, node: int64}, () => {
  set('node', retrieve('theorems', get('implication'))[0])
  if (retrieve('formulas', get('node'))[0] == 3 && retrieve('formulas', get('node'))[1] == retrieve('theorems', get('antecedent'))[0]) {
    call('appendTheorem', {node: retrieve('formulas', get('node'))[2]})
  } else { call('no', {}) }
})

procedure('generalize', {theorem: int64}, () => {
  call('intern', {tag: 4, a: retrieve('theorems', get('theorem'))[0], b: 0})
  call('appendTheorem', {node: retrieve('meta', 0)[0]})
})
